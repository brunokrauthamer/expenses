# Dados de conexão locais. Não versione o arquivo .env com credenciais reais.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/personal_expenses

# Gere duas chaves distintas de 32 bytes, codificadas em Base64.
# Exemplo no PowerShell: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
AUTH_ENCRYPTION_KEY=gere-uma-chave-base64-de-32-bytes
AUTH_LOOKUP_KEY=gere-outra-chave-base64-de-32-bytes
AUTH_ENCRYPTION_KEY_VERSION=1
AUTH_TOKEN_SECRET=gere-uma-chave-base64-de-32-bytes-para-cookie-oauth
# Gere um par RSA com openssl e codifique ambos os arquivos PEM em Base64.
AUTH_JWT_PRIVATE_KEY_B64=chave-privada-rsa-pem-em-base64
AUTH_JWT_PUBLIC_KEY_B64=chave-publica-rsa-pem-em-base64
AUTH_TOKEN_ISSUER=expenses-api
AUTH_TOKEN_AUDIENCE=expenses-web
AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_REFRESH_TOKEN_DAYS=30
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_PATH=/api/auth
AUTH_FRONTEND_URL=http://localhost:5173

# Obrigatório para permitir acesso ao Expenses. Cadastre o callback exato no Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback
